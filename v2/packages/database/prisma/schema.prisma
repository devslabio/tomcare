generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  ADMIN
  EDITOR
}

enum MessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum CaseStatus {
  NEW
  IN_PROGRESS
  ACCEPTED
  CLOSED
  ARCHIVED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum TeamGroup {
  BOARD
  STAFF
  VOLUNTEER
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         StaffRole @default(EDITOR)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

model Program {
  id         String   @id @default(uuid())
  slug       String   @unique
  title      String
  category   String
  summary    String
  body       String   @default("")
  icon       String   @default("heart-handshake")
  image      String?
  /// Short "what you get" lines listed beside the page text
  highlights String[] @default([])
  featured   Boolean  @default(false)
  visible    Boolean  @default(true)
  sortOrder  Int      @default(0)
  /// French version of the translatable fields; missing ones fall back to English.
  fr         Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([visible, sortOrder])
  @@map("programs")
}

/// Everyday practical help (CV writing, passport photos, SAAQ registration...)
model Service {
  id          String   @id @default(uuid())
  title       String
  description String
  icon        String   @default("file-text")
  visible     Boolean  @default(true)
  sortOrder   Int      @default(0)
  /// French version of the translatable fields; missing ones fall back to English.
  fr          Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([visible, sortOrder])
  @@map("services")
}

model Event {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  summary     String
  body        String    @default("")
  image       String?
  startsAt    DateTime
  endsAt      DateTime?
  location    String
  registerUrl String?
  visible     Boolean   @default(true)
  /// French version of the translatable fields; missing ones fall back to English.
  fr          Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([visible, startsAt])
  @@map("events")
}

model Post {
  id          String        @id @default(uuid())
  slug        String        @unique
  title       String
  excerpt     String
  body        String        @default("")
  coverImage  String?
  author      String        @default("TOMCARE Team")
  category    String        @default("News")
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  /// French version of the translatable fields; missing ones fall back to English.
  fr          Json          @default("{}")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
  @@map("posts")
}

/// Pages staff build from content blocks; served at /<slug>.
model Page {
  id          String        @id @default(uuid())
  slug        String        @unique
  title       String
  description String        @default("")
  heroImage   String?
  /// [{ id, type, ...fields }] — see apps/web/src/lib/blocks.ts
  blocks      Json          @default("[]")
  status      PublishStatus @default(DRAFT)
  showInNav   Boolean       @default(false)
  navLabel    String?
  sortOrder   Int           @default(0)
  /// French version of the translatable fields; missing ones fall back to English.
  fr          Json          @default("{}")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("pages")
}

model TeamMember {
  id        String    @id @default(uuid())
  name      String
  role      String
  bio       String    @default("")
  photo     String?
  group     TeamGroup @default(STAFF)
  visible   Boolean   @default(true)
  sortOrder Int       @default(0)
  /// French version of the translatable fields; missing ones fall back to English.
  fr        Json      @default("{}")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([visible, sortOrder])
  @@map("team_members")
}

model Testimonial {
  id        String   @id @default(uuid())
  quote     String
  name      String
  role      String
  photo     String?
  visible   Boolean  @default(true)
  sortOrder Int      @default(0)
  /// French version of the translatable fields; missing ones fall back to English.
  fr        Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonials")
}

model Partner {
  id          String   @id @default(uuid())
  name        String
  logoUrl     String?
  website     String?
  description String?
  visible     Boolean  @default(true)
  sortOrder   Int      @default(0)
  /// French version of the translatable fields; missing ones fall back to English.
  fr          Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("partners")
}

model VolunteerRole {
  id          String   @id @default(uuid())
  title       String
  description String
  commitment  String
  location    String
  skills      String[] @default([])
  visible     Boolean  @default(true)
  sortOrder   Int      @default(0)
  /// French version of the translatable fields; missing ones fall back to English.
  fr          Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("volunteer_roles")
}

model ContactMessage {
  id        String        @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    MessageStatus @default(NEW)
  readAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@map("contact_messages")
}

model VolunteerApplication {
  id           String     @id @default(uuid())
  name         String
  email        String
  phone        String?
  role         String?
  availability String?
  experience   String?
  message      String?
  status       CaseStatus @default(NEW)
  notes        String     @default("")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status, createdAt])
  @@map("volunteer_applications")
}

enum DonationFrequency {
  ONCE
  MONTHLY
  QUARTERLY
  YEARLY
}

enum DonationMethod {
  ETRANSFER
  ONLINE
  IN_PERSON
}

/// A gift someone pledged on the Donate page. No payment is taken on the site; staff follow up.
model DonationPledge {
  id          String            @id @default(uuid())
  name        String
  email       String
  phone       String?
  /// Canadian dollars, in cents.
  amountCents Int
  frequency   DonationFrequency @default(ONCE)
  /// English title of the program the gift is for; null means where it's needed most.
  cause       String?
  method      DonationMethod
  message     String?
  anonymous   Boolean           @default(false)
  status      CaseStatus        @default(NEW)
  notes       String            @default("")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, createdAt])
  @@map("donation_pledges")
}

/// "Get help" registrations from newcomers and people in need.
model AssistanceRequest {
  id        String     @id @default(uuid())
  name      String
  email     String
  phone     String?
  language  String?
  city      String?
  needs     String[]   @default([])
  story     String
  status    CaseStatus @default(NEW)
  notes     String     @default("")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, createdAt])
  @@map("assistance_requests")
}

model Subscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("subscribers")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}
