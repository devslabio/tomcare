generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  ADMIN
  EDITOR
}

enum MessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum CaseStatus {
  NEW
  IN_PROGRESS
  ACCEPTED
  CLOSED
  ARCHIVED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum TeamGroup {
  BOARD
  STAFF
  VOLUNTEER
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         StaffRole @default(EDITOR)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

model Program {
  id         String   @id @default(uuid())
  slug       String   @unique
  title      String
  category   String
  summary    String
  body       String   @default("")
  icon       String   @default("heart-handshake")
  image      String?
  /// Short "what you get" lines listed beside the page text
  highlights String[] @default([])
  featured   Boolean  @default(false)
  visible    Boolean  @default(true)
  sortOrder  Int      @default(0)
  /// French version of the translatable fields; missing ones fall back to English.
  fr         Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([visible, sortOrder])
  @@map("programs")
}

/// Everyday practical help (CV writing, passport photos, SAAQ registration...)
model Service {
  id          String   @id @default(uuid())
  title       String
  description String
  icon        String   @default("file-text")
  visible     Boolean  @default(true)
  sortOrder   Int      @default(0)
  /// French version of the translatable fields; missing ones fall back to English.
  fr          Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([visible, sortOrder])
  @@map("services")
}

model Event {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  summary     String
  body        String    @default("")
  image       String?
  startsAt    DateTime
  endsAt      DateTime?
  location    String
  registerUrl String?
  visible     Boolean   @default(true)
  /// French version of the translatable fields; missing ones fall back to English.
  fr          Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([visible, startsAt])
  @@map("events")
}

model Post {
  id          String        @id @default(uuid())
  slug        String        @unique
  title       String
  excerpt     String
  body        String        @default("")
  coverImage  String?
  author      String        @default("TOMCARE Team")
  category    String        @default("News")
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  /// French version of the translatable fields; missing ones fall back to English.
  fr          Json          @default("{}")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
  @@map("posts")
}

/// Pages staff build from content blocks; served at /<slug>.
model Page {
  id          String        @id @default(uuid())
  slug        String        @unique
  title       String
  description String        @default("")
  heroImage   String?
  /// [{ id, type, ...fields }] — see apps/web/src/lib/blocks.ts
  blocks      Json          @default("[]")
  status      PublishStatus @default(DRAFT)
  showInNav   Boolean       @default(false)
  navLabel    String?
  sortOrder   Int           @default(0)
  /// French version of the translatable fields; missing ones fall back to English.
  fr          Json          @default("{}")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("pages")
}

model TeamMember {
  id        String    @id @default(uuid())
  name      String
  role      String
  bio       String    @default("")
  photo     String?
  group     TeamGroup @default(STAFF)
  visible   Boolean   @default(true)
  sortOrder Int       @default(0)
  /// French version of the translatable fields; missing ones fall back to English.
  fr        Json      @default("{}")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([visible, sortOrder])
  @@map("team_members")
}

model Testimonial {
  id        String   @id @default(uuid())
  quote     String
  name      String
  role      String
  photo     String?
  visible   Boolean  @default(true)
  sortOrder Int      @default(0)
  /// French version of the translatable fields; missing ones fall back to English.
  fr        Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonials")
}

model Partner {
  id          String   @id @default(uuid())
  name        String
  logoUrl     String?
  website     String?
  description String?
  visible     Boolean  @default(true)
  sortOrder   Int      @default(0)
  /// French version of the translatable fields; missing ones fall back to English.
  fr          Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("partners")
}

/// Slides of the carousel at the top of the home page.
model HeroSlide {
  id        String   @id @default(uuid())
  eyebrow   String   @default("")
  title     String
  subtitle  String   @default("")
  image     String
  imageAlt  String   @default("")
  ctaLabel  String   @default("")
  ctaHref   String   @default("")
  visible   Boolean  @default(true)
  sortOrder Int      @default(0)
  /// French version of the translatable fields; missing ones fall back to English.
  fr        Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hero_slides")
}

model VolunteerRole {
  id          String   @id @default(uuid())
  title       String
  description String
  commitment  String
  location    String
  skills      String[] @default([])
  visible     Boolean  @default(true)
  sortOrder   Int      @default(0)
  /// French version of the translatable fields; missing ones fall back to English.
  fr          Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("volunteer_roles")
}

model ContactMessage {
  id        String        @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    MessageStatus @default(NEW)
  readAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@map("contact_messages")
}

model VolunteerApplication {
  id           String     @id @default(uuid())
  name         String
  email        String
  phone        String?
  role         String?
  availability String?
  experience   String?
  message      String?
  status       CaseStatus @default(NEW)
  notes        String     @default("")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status, createdAt])
  @@map("volunteer_applications")
}

enum DonationFrequency {
  ONCE
  MONTHLY
  QUARTERLY
  YEARLY
}

enum DonationMethod {
  CARD
  ETRANSFER
  ONLINE
  IN_PERSON
}

/// A gift made on the Donate page. CARD gifts are paid through Stripe Checkout; the others are pledges staff follow up.
model DonationPledge {
  id                   String            @id @default(uuid())
  name                 String
  email                String
  phone                String?
  /// Canadian dollars, in cents.
  amountCents          Int
  frequency            DonationFrequency @default(ONCE)
  /// English title of the program the gift is for; null means where it's needed most.
  cause                String?
  method               DonationMethod
  message              String?
  anonymous            Boolean           @default(false)
  status               CaseStatus        @default(NEW)
  notes                String            @default("")
  stripeSessionId      String?
  stripeSubscriptionId String?
  /// Set once Stripe confirms the (first) payment; a CARD gift without it was abandoned at checkout.
  paidAt               DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([stripeSessionId])
  @@map("donation_pledges")
}

enum ItemCategory {
  CLOTHING
  HOUSEHOLD
  FURNITURE
  VEHICLE
  OTHER
}

enum ItemHandoff {
  DROP_OFF
  PICK_UP
}

/// Clothes, household goods, furniture or a vehicle someone offered on the Donate page.
model ItemDonation {
  id           String         @id @default(uuid())
  name         String
  email        String
  phone        String?
  categories   ItemCategory[]
  description  String
  handoff      ItemHandoff
  /// Only for pick-ups.
  address      String?
  postalCode   String?
  /// Only when a vehicle is offered.
  vehicle      String?
  vehicleYear  Int?
  vehicleRuns  Boolean?
  hasOwnership Boolean?
  status       CaseStatus     @default(NEW)
  notes        String         @default("")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status, createdAt])
  @@map("item_donations")
}

/// "Get help" registrations from newcomers and people in need.
model AssistanceRequest {
  id        String     @id @default(uuid())
  name      String
  email     String
  phone     String?
  language  String?
  city      String?
  needs     String[]   @default([])
  story     String
  status    CaseStatus @default(NEW)
  notes     String     @default("")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, createdAt])
  @@map("assistance_requests")
}

model Subscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("subscribers")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}
