# Production secrets for docker/docker-compose.prod.yml (DO NOT COMMIT docker/.env)
#   cp docker/.env.example docker/.env && chmod 600 docker/.env

# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 48
JWT_SECRET=

# First administrator, created only when there are no staff accounts yet.
# Leave the password empty to have one generated and printed in the API logs
# (docker logs tomcare-api | grep "temporary password").
SEED_ADMIN_EMAIL=admin@tomcarefoundation.org
SEED_ADMIN_NAME=TOMCARE Admin
SEED_ADMIN_PASSWORD=

# Public address (canonical URLs, sitemap, social previews). Baked in at build time.
SITE_URL=https://tomcarefoundation.org
